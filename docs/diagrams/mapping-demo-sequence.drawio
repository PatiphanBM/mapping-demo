        <mxCell id="main-head-norm" value="9. Normalize Worker&#xA;process 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1765" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="main-line-normalized" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2065" y="214" as="sourcePoint" /><mxPoint x="2065" y="2632" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-head-normalized" value="10. PostgreSQL&#xA;Normalized / Row Error" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1980" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="main-line-archive" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2280" y="214" as="sourcePoint" /><mxPoint x="2280" y="2632" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-head-archive" value="11. Archive Folder" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="2195" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="main-47" value="" style="rounded=0;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="33" y="2187" width="2344" height="271" as="geometry" /></mxCell>
        <mxCell id="main-36" value="" style="rounded=0;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="655" y="945" width="1530" height="1040" as="geometry" /></mxCell>
        <mxCell id="main-33" value="" style="rounded=0;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="1740" y="1620" width="435" height="226" as="geometry" /></mxCell>
        <mxCell id="main-1" value="A. รับไฟล์ — Watcher สร้าง File Import Job" style="rounded=0;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#16324F;fillColor=#E8EEF5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="264" width="2354" height="32" as="geometry" /></mxCell>
        <mxCell id="main-2" value="1. วาง CSV → Created / Renamed" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="337" as="sourcePoint" /><mxPoint x="345" y="337" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-3" value="2. ข้ามไฟล์ที่ไม่ใช่ .csv / folder ไม่มี active config → log&#xA;กัน event ซ้ำ: configId + path + size + lastWriteTime" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="150" y="361" width="390" height="50" as="geometry" /></mxCell>
        <mxCell id="main-4" value="3. File Job (Queued) + ตรึง config version&#xA;ผ่าน Outbox → Dispatcher publish, key = fileJobId" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="345" y="469" as="sourcePoint" /><mxPoint x="560" y="469" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-5" value="4. ส่ง File Job ให้ consumer ของ partition" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="514" as="sourcePoint" /><mxPoint x="775" y="514" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-6" value="B. หน่วง 30 วินาที → snapshot → ตรวจ duplicate" style="rounded=0;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#16324F;fillColor=#E8EEF5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="546" width="2354" height="32" as="geometry" /></mxCell>
        <mxCell id="main-7" value="5. Delaying: async delay 30 วินาที (ยกเลิกได้)&#xA;ยังไม่ commit offset; ไฟล์คนละ partition หน่วงพร้อมกัน" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="575" y="598" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="main-8" value="6. copy ไฟล์เป็น snapshot ใน staging" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="689" as="sourcePoint" /><mxPoint x="130" y="689" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-9" value="7. คำนวณ content hash จาก snapshot" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="640" y="713" width="270" height="33" as="geometry" /></mxCell>
        <mxCell id="main-10" value="8. ตรวจ duplicate: configId + content hash" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="787" as="sourcePoint" /><mxPoint x="990" y="787" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-11" value="ถ้า duplicate: import_status = Duplicate แล้วย้ายไฟล์ไป Archive — ไม่สร้าง Source / Row Job เพิ่ม&#xA;ถ้าเปิดหรือ copy ไม่ได้: ImportFailed แล้วใช้ retry | ด้านล่างเป็นเส้นทางไฟล์ใหม่ ซึ่ง parse จาก snapshot เท่านั้น" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=13;fillColor=#FFF8E1;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="655" y="811" width="1722" height="52" as="geometry" /></mxCell>
        <mxCell id="main-12" value="C. นำเข้า Source และ Normalize ทำงานขนานกัน" style="rounded=0;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#16324F;fillColor=#E8EEF5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="891" width="2354" height="32" as="geometry" /></mxCell>
        <mxCell id="main-13" value="par" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#315B7D;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="655" y="945" width="54" height="28" as="geometry" /></mxCell>
        <mxCell id="main-14" value="[Import — loop ทุก record จาก snapshot; rownumber เริ่ม 1 ไม่นับ header; 1 record = 1 transaction]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="659" y="979" width="1522" height="22" as="geometry" /></mxCell>
        <mxCell id="main-15" value="9. INSERT Source row&#xA;(field เป็น string + rownumber)" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="1043" as="sourcePoint" /><mxPoint x="990" y="1043" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-16" value="10. INSERT Row Job (Pending) + Outbox&#xA;→ COMMIT (transaction เดียวกับข้อ 9)" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="1105" as="sourcePoint" /><mxPoint x="1205" y="1105" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-17" value="11. poll Outbox ที่ยังไม่ส่ง&#xA;ทุก 500ms ครั้งละ ≤ 100" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="1167" as="sourcePoint" /><mxPoint x="1205" y="1167" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-18" value="12. publish Row Job&#xA;key = sourceRowId" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="1229" as="sourcePoint" /><mxPoint x="1635" y="1229" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-19" value="13. broker ack" style="endArrow=open;endFill=0;dashed=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1635" y="1274" as="sourcePoint" /><mxPoint x="1420" y="1274" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-20" value="14. บันทึก sent_at (at-least-once)" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="1319" as="sourcePoint" /><mxPoint x="1205" y="1319" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-21" value="" style="endArrow=none;dashed=1;strokeColor=#6C8EBF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="1347" as="sourcePoint" /><mxPoint x="2185" y="1347" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-22" value="[Normalize — ทุก Row Job; เริ่มได้ทันทีหลังแถวนั้น commit ไม่ต้องรอทั้งไฟล์ และไม่มี delay]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="659" y="1353" width="1522" height="22" as="geometry" /></mxCell>
        <mxCell id="main-23" value="15. ส่ง Row Job" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1635" y="1400" as="sourcePoint" /><mxPoint x="1850" y="1400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-24" value="16. ตรวจ / claim Row Job&#xA;Done หรือ Invalid แล้ว → ข้าม + commit offset" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="1462" as="sourcePoint" /><mxPoint x="1205" y="1462" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-25" value="17. อ่าน Source row + config version ที่ตรึงไว้" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="1507" as="sourcePoint" /><mxPoint x="990" y="1507" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-26" value="18. trim → required → convert&#xA;date yyyy-MM-dd | decimal Invariant&#xA;boolean true/false/1/0 | เก็บ error ทุก field" style="rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=13;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1685" y="1531" width="330" height="67" as="geometry" /></mxCell>
        <mxCell id="main-27" value="alt" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#315B7D;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1740" y="1620" width="54" height="28" as="geometry" /></mxCell>
        <mxCell id="main-28" value="[ผ่าน validation]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="1744" y="1654" width="427" height="22" as="geometry" /></mxCell>
        <mxCell id="main-29" value="19a. INSERT Normalized + version&#xA;Row Job = Done" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="1718" as="sourcePoint" /><mxPoint x="2065" y="1718" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-30" value="" style="endArrow=none;dashed=1;strokeColor=#6C8EBF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1740" y="1746" as="sourcePoint" /><mxPoint x="2175" y="1746" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-31" value="[ผิด validation]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="1744" y="1752" width="427" height="22" as="geometry" /></mxCell>
        <mxCell id="main-32" value="19b. Row Error ทุก field: rownumber / field / สาเหตุ&#xA;Row Job = Invalid (ไม่ retry อัตโนมัติ)" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="1816" as="sourcePoint" /><mxPoint x="2065" y="1816" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-34" value="20. commit offset หลัง DB commit" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="1883" as="sourcePoint" /><mxPoint x="1635" y="1883" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-35" value="ระบบล้ม (DB / timeout): ไม่ commit offset, retry 3 ครั้งแบบ backoff&#xA;ยังไม่ผ่าน → Row Job = Failed แล้ว commit offset; สั่งซ้ำผ่าน POST /row-jobs/{id}/retry" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=13;fillColor=#FFF8E1;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1535" y="1907" width="630" height="52" as="geometry" /></mxCell>
        <mxCell id="main-37" value="D. หลังนำเข้า Source ครบ → Archive (ไม่รอ Normalize)" style="rounded=0;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#16324F;fillColor=#E8EEF5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="28" y="2009" width="2354" height="32" as="geometry" /></mxCell>
        <mxCell id="main-38" value="21. import_status = Imported&#xA;บันทึก total_rows" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="2099" as="sourcePoint" /><mxPoint x="990" y="2099" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-39" value="22. hash ไฟล์จริงใน input folder&#xA;เทียบกับ hash ของ snapshot" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="2161" as="sourcePoint" /><mxPoint x="130" y="2161" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-40" value="alt" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#315B7D;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="33" y="2187" width="54" height="28" as="geometry" /></mxCell>
        <mxCell id="main-41" value="[hash ตรงกัน]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="37" y="2221" width="2336" height="22" as="geometry" /></mxCell>
        <mxCell id="main-42" value="23a. ย้ายไป archive/{configId}/{yyyyMMdd}/{fileJobId}_{ชื่อเดิม}" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="2268" as="sourcePoint" /><mxPoint x="2280" y="2268" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-43" value="24a. archive_status = Archived&#xA;ลบ snapshot" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="2330" as="sourcePoint" /><mxPoint x="990" y="2330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-44" value="" style="endArrow=none;dashed=1;strokeColor=#6C8EBF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="33" y="2358" as="sourcePoint" /><mxPoint x="2377" y="2358" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-45" value="[hash ไม่ตรง — partner แก้ไฟล์หลัง copy]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="37" y="2364" width="2336" height="22" as="geometry" /></mxCell>
        <mxCell id="main-46" value="23b. archive_status = ChangedAfterRead&#xA;ไม่ย้ายไฟล์ รอคนตัดสิน" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="2428" as="sourcePoint" /><mxPoint x="990" y="2428" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-48" value="25. commit offset ของ File Job" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="2495" as="sourcePoint" /><mxPoint x="560" y="2495" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-49" value="ย้ายซ้ำได้: ถ้าไฟล์อยู่ที่ archive path แล้วให้ตั้งสถานะเท่านั้น | ย้ายไม่ได้ retry 3 ครั้ง → ArchiveFailed | Archive folder ต้องไม่อยู่ใต้ input folder&#xA;สถานะแยก 3 มิติ: import_status / archive_status / normalization_status — Archived ไม่ได้แปลว่า normalize เสร็จ&#xA;ปิดผลไฟล์เมื่อ Imported และไม่มี Row Job Pending → Completed / CompletedWithErrors (Invalid, Failed นับว่าปิด); ยอดแยกสถานะ query จาก Row Jobs" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=13;fillColor=#F4F7FA;strokeColor=#BAC8D3;" vertex="1" parent="1"><mxGeometry x="33" y="2519" width="2344" height="69" as="geometry" /></mxCell>
        <mxCell id="main-footer" value="Mapping Demo | C# / ASP.NET Core | Kafka + PostgreSQL in Docker | Editable sequence diagram" style="text;html=0;align=left;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="30" y="2652" width="2357" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="retry" name="02 - Retry and Reprocess">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1508" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="retry-title" value="02  Retry / Reprocess ผ่าน API → Outbox → Kafka" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1660" height="44" as="geometry" /></mxCell>
        <mxCell id="retry-subtitle" value="Retry ใช้ข้อมูลและ config version เดิม | Reprocess normalize จาก Source ด้วย version ที่เลือก ไม่อ่าน CSV ใหม่&#xA;ชื่อ endpoint เป็นข้อเสนอ; หลักการ version และการเก็บผลเป็นข้อสรุปที่ตกลงแล้ว" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1660" height="60" as="geometry" /></mxCell>
        <mxCell id="retry-line-client" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="214" as="sourcePoint" /><mxPoint x="130" y="1448" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-head-client" value="1. ผู้ดูแล / API Client" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="45" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="retry-line-api" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="214" as="sourcePoint" /><mxPoint x="370" y="1448" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-head-api" value="2. Config / Job API&#xA;process 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="285" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="retry-line-db" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="214" as="sourcePoint" /><mxPoint x="610" y="1448" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-head-db" value="3. PostgreSQL&#xA;Jobs / Outbox / Source / Normalized" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="525" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="retry-line-disp" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="214" as="sourcePoint" /><mxPoint x="850" y="1448" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-head-disp" value="4. Outbox Dispatcher&#xA;process 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="765" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="retry-line-kafka" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="214" as="sourcePoint" /><mxPoint x="1090" y="1448" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-head-kafka" value="5. Kafka&#xA;file-import / row-normalize" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1005" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="retry-line-import" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="214" as="sourcePoint" /><mxPoint x="1330" y="1448" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-head-import" value="6. Import Worker&#xA;process 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1245" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="retry-line-norm" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="214" as="sourcePoint" /><mxPoint x="1570" y="1448" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-head-norm" value="7. Normalize Worker&#xA;process 2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1485" y="150" width="170" height="64" as="geometry" /></mxCell>
        <mxCell id="retry-25" value="" style="rounded=0;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="500" y="1003" width="1180" height="316" as="geometry" /></mxCell>
        <mxCell id="retry-12" value="" style="rounded=0;fillColor=none;strokeColor=#6C8EBF;dashed=1;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="20" y="318" width="700" height="440" as="geometry" /></mxCell>
        <mxCell id="retry-1" value="A. รับคำสั่ง — API บันทึก job + Outbox แล้วตอบทันที" style="rounded=0;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#16324F;fillColor=#E8EEF5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="15" y="264" width="1670" height="32" as="geometry" /></mxCell>
        <mxCell id="retry-2" value="alt" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#315B7D;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="318" width="54" height="28" as="geometry" /></mxCell>
        <mxCell id="retry-3" value="[Retry — config version เดิม]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="24" y="352" width="692" height="22" as="geometry" /></mxCell>
        <mxCell id="retry-4" value="1a. POST /file-jobs/{id}/retry&#xA;หรือ POST /row-jobs/{id}/retry" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="416" as="sourcePoint" /><mxPoint x="370" y="416" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-5" value="2a. บันทึก retry attempt + Outbox&#xA;ข้อมูลและ version เดิม" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="478" as="sourcePoint" /><mxPoint x="610" y="478" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-6" value="3a. 202 Accepted + attemptId" style="endArrow=open;endFill=0;dashed=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="523" as="sourcePoint" /><mxPoint x="130" y="523" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-7" value="" style="endArrow=none;dashed=1;strokeColor=#6C8EBF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="551" as="sourcePoint" /><mxPoint x="720" y="551" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-8" value="[Reprocess — เลือก config version ได้]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="24" y="557" width="692" height="22" as="geometry" /></mxCell>
        <mxCell id="retry-9" value="1b. POST /file-jobs/{id}/reprocess&#xA;+ configVersionId" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="621" as="sourcePoint" /><mxPoint x="370" y="621" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-10" value="2b. ตรวจว่า Source มี field ที่ version ใหม่ต้องใช้&#xA;กันแถวเดิมรันซ้อน; บันทึก run + Row Job + Outbox ต่อแถว" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="683" as="sourcePoint" /><mxPoint x="610" y="683" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-11" value="3b. 202 Accepted + runId" style="endArrow=open;endFill=0;dashed=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="728" as="sourcePoint" /><mxPoint x="130" y="728" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-13" value="B. ส่งคำสั่งเข้า Kafka" style="rounded=0;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#16324F;fillColor=#E8EEF5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="15" y="782" width="1670" height="32" as="geometry" /></mxCell>
        <mxCell id="retry-14" value="4. poll Outbox ที่ยังไม่ส่ง" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="855" as="sourcePoint" /><mxPoint x="610" y="855" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-15" value="5. publish: file retry → mapping.file-import&#xA;row retry / reprocess → mapping.row-normalize" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="917" as="sourcePoint" /><mxPoint x="1090" y="917" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-16" value="C. ประมวลผลตามชนิดคำสั่ง" style="rounded=0;html=0;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fontColor=#16324F;fillColor=#E8EEF5;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="15" y="949" width="1670" height="32" as="geometry" /></mxCell>
        <mxCell id="retry-17" value="alt" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#315B7D;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="500" y="1003" width="54" height="28" as="geometry" /></mxCell>
        <mxCell id="retry-18" value="[File retry]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="504" y="1037" width="1172" height="22" as="geometry" /></mxCell>
        <mxCell id="retry-19" value="6a. ส่ง File Job (attempt)" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="1084" as="sourcePoint" /><mxPoint x="1330" y="1084" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-20" value="7a. นำเข้าต่อจาก snapshot เดิม (ตรวจ hash)&#xA;ข้ามแถวที่ commit แล้ว ไม่สร้าง Source ซ้ำ" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="1146" as="sourcePoint" /><mxPoint x="610" y="1146" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-21" value="" style="endArrow=none;dashed=1;strokeColor=#6C8EBF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="1174" as="sourcePoint" /><mxPoint x="1680" y="1174" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-22" value="[Row retry / Reprocess]" style="text;html=0;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fontStyle=3;fontColor=#315B7D;" vertex="1" parent="1"><mxGeometry x="504" y="1180" width="1172" height="22" as="geometry" /></mxCell>
        <mxCell id="retry-23" value="6b. ส่ง Row Job (attempt / run)" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="1227" as="sourcePoint" /><mxPoint x="1570" y="1227" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-24" value="7b. normalize ด้วย version ของ attempt / run&#xA;บันทึกผล + ประวัติ; ป้องกันผลซ้ำ" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1570" y="1289" as="sourcePoint" /><mxPoint x="610" y="1289" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="retry-26" value="Reprocess ผ่าน: อัปเดต Normalized ของ Source แถวเดิม พร้อม version ที่ใช้ และเก็บประวัติ&#xA;Reprocess ไม่ผ่าน: เก็บผลสำเร็จเดิมและ version เดิม (Current Normalized Result) พร้อม error ของการรันล่าสุดแยกกัน&#xA;Reprocess ทั้งไฟล์กระจายเป็น Row Job รายแถวผ่าน Outbox และไม่เปลี่ยน version ของ File Import Job เดิม" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=13;fillColor=#F4F7FA;strokeColor=#BAC8D3;" vertex="1" parent="1"><mxGeometry x="30" y="1335" width="1640" height="69" as="geometry" /></mxCell>
        <mxCell id="retry-footer" value="Mapping Demo | C# / ASP.NET Core | Kafka + PostgreSQL in Docker | Editable sequence diagram" style="text;html=0;align=left;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="30" y="1468" width="1660" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="config" name="03 - Mapping Configuration">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1026" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="config-title" value="03  ตั้งค่า Schema และ Mapping" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="920" height="44" as="geometry" /></mxCell>
        <mxCell id="config-subtitle" value="Process 1: Config API | หนึ่ง config ผูกหนึ่ง folder → Source หนึ่งตาราง → Normalized หนึ่งตาราง&#xA;ทำก่อนมีไฟล์เข้า; รายละเอียด API เป็นข้อเสนอจากแผน" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="920" height="60" as="geometry" /></mxCell>
        <mxCell id="config-line-client" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="214" as="sourcePoint" /><mxPoint x="150" y="966" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="config-head-client" value="1. ผู้ดูแล / API Client" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="65" y="150" width="170" height="64" as="geometry" /></mxCell>
