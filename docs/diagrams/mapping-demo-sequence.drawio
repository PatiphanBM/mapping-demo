        <mxCell id="main-head-outbox" value="6. PostgreSQL&#xA;Row Jobs / Outbox" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="170" height="64" as="geometry" /></mxCell>
