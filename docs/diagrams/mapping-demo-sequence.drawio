        <mxCell id="main-title" value="01  Main Flow: CSV → Source → Normalized → Archive" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2357" height="44" as="geometry" /></mxCell>
        <mxCell id="main-subtitle" value="แท่งเรียงซ้าย→ขวาตามลำดับงานใน flowchart ของ demo-plan: Folder → Watcher → Kafka file → Import → Source / Outbox → Dispatcher → Kafka row → Normalize → Normalized → Archive&#xA;Process 1 = Config API + File Watcher | Process 2 = Mapping Worker (Import, Dispatcher, Normalize); Config API อยู่หน้า 03" style="text;html=0;align=left;verticalAlign=top;fontSize=14;fontColor=#526477;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="2357" height="60" as="geometry" /></mxCell>
        <mxCell id="main-line-folder" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="214" as="sourcePoint" /><mxPoint x="130" y="2632" as="targetPoint" /></mxGeometry></mxCell>
