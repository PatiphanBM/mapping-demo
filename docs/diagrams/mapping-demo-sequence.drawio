        <mxCell id="main-head-source" value="5. PostgreSQL&#xA;File Jobs / Source" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="905" y="150" width="170" height="64" as="geometry" /></mxCell>
