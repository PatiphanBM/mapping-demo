        <mxCell id="main-line-krow" value="" style="endArrow=none;dashed=1;strokeColor=#ACB8C4;strokeWidth=1.5;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1635" y="214" as="sourcePoint" /><mxPoint x="1635" y="2632" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="main-head-krow" value="8. Kafka&#xA;mapping.row-normalize" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1550" y="150" width="170" height="64" as="geometry" /></mxCell>
