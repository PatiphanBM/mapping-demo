        <mxCell id="config-9" value="9. POST .../versions/{v}/activate" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="739" as="sourcePoint" /><mxPoint x="470" y="739" as="targetPoint" /></mxGeometry></mxCell>
