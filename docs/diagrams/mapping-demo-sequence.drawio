        <mxCell id="config-3" value="3. POST /tables — Normalized table&#xA;text / date / decimal / boolean" style="endArrow=block;endFill=1;strokeWidth=1.5;fontSize=13;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;html=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="418" as="sourcePoint" /><mxPoint x="470" y="418" as="targetPoint" /></mxGeometry></mxCell>
