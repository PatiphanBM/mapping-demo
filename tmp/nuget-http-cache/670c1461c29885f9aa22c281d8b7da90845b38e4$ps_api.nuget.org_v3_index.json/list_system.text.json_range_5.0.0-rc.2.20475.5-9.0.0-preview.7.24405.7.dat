performance and low-allocating types that serialize objects to JavaScript Object Notation (JSON) text and deserialize JSON text to objects, with UTF-8 support built-in. Also provides types to read and write JSON text encoded as UTF-8, and to create an in-memory document object model (DOM), that is read-only, for random access of the JSON elements within a structured view of the data.\n\nCommonly Used Types:\nSystem.Text.Json.JsonSerializer\nSystem.Text.Json.JsonDocument\nSystem.Text.Json.JsonElement\nSystem.Text.Json.Utf8JsonWriter\nSystem.Text.Json.Utf8JsonReader\n \nWhen using NuGet 3.x this package requires at least version 3.4.","iconUrl":"https://api.nuget.org/v3-flatcontainer/system.text.json/5.0.1/icon","id":"System.Text.Json","language":"","licenseExpression":"MIT","licenseUrl":"https://www.nuget.org/packages/System.Text.Json/5.0.1/license","listed":true,"minClientVersion":"2.12","packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/5.0.1/system.text.json.5.0.1.nupkg","projectUrl":"https://github.com/dotnet/runtime","published":"2021-01-12T14:41:14.227+00:00","requireLicenseAcceptance":false,"summary":"","tags":[""],"title":"System.Text.Json","version":"5.0.1"},"packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/5.0.1/system.text.json.5.0.1.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/5.0.2.json","@type":"Package","commitId":"d63a743e-ebb7-49f3-907d-a725936139f0","commitTimeStamp":"2024-07-10T16:10:39.6058534+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2024.07.10.16.09.35/system.text.json.5.0.2.json","@type":"PackageDetails","authors":"Microsoft","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.07.10.16.09.35/system.text.json.5.0.2.json#dependencygroup/monoandroid1.0","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nug