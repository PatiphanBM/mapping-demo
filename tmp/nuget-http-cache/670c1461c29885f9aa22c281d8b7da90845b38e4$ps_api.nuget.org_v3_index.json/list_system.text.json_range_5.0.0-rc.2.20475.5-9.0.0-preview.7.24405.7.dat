east version 3.4.","iconUrl":"https://api.nuget.org/v3-flatcontainer/system.text.json/5.0.0/icon","id":"System.Text.Json","language":"","licenseExpression":"MIT","licenseUrl":"https://www.nuget.org/packages/System.Text.Json/5.0.0/license","listed":true,"minClientVersion":"2.12","packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/5.0.0/system.text.json.5.0.0.nupkg","projectUrl":"https://github.com/dotnet/runtime","published":"2020-11-09T23:44:12.893+00:00","requireLicenseAcceptance":false,"summary":"","tags":[""],"title":"System.Text.Json","version":"5.0.0"},"packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/5.0.0/system.text.json.5.0.0.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/5.0.1.json","@type":"Package","commitId":"d63a743e-ebb7-49f3-907d-a725936139f0","commitTimeStamp":"2024-07-10T16:10:39.6058534+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2024.07.10.16.09.35/system.text.json.5.0.1.json","@type":"PackageDetails","authors":"Microsoft","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.07.10.16.09.35/system.text.json.5.0.1.json#dependencygroup/monoandroid1.0","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nuget.org/v3/catalog0/data/2024.07.10.16.09.35/system.text.json.5.0.1.json#dependencygroup/monoandroid1.0/microsoft.bcl.asyncinterfaces","@type":"PackageDependency","id":"Microsoft.Bcl.AsyncInterfaces","range":"[5.0.0, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/microsoft.bcl.asyncinterfaces/index.json"},{"@id":"https://api.nuget.org/v3/catalog0/data/2024.07.10.16.09.35/system.text.json.5.0.1.json#dependencygroup/monoandroid1.0/system.buffers","@type":"PackageDependency","id":"System.Buffers","range":"[4.5.1, )","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.buffers/i