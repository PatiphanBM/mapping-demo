llocating types that serialize objects to JavaScript Object Notation (JSON) text and deserialize JSON text to objects, with UTF-8 support built-in. Also provides types to read and write JSON text encoded as UTF-8, and to create an in-memory document object model (DOM), that is read-only, for random access of the JSON elements within a structured view of the data.\n\nThe System.Text.Json library is built-in as part of the shared framework in .NET Runtime. The package can be installed when you need to use it in other target frameworks.","iconUrl":"https://api.nuget.org/v3-flatcontainer/system.text.json/9.0.0-preview.7.24405.7/icon","id":"System.Text.Json","language":"","licenseExpression":"MIT","licenseUrl":"https://www.nuget.org/packages/System.Text.Json/9.0.0-preview.7.24405.7/license","listed":true,"minClientVersion":"","packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/9.0.0-preview.7.24405.7/system.text.json.9.0.0-preview.7.24405.7.nupkg","projectUrl":"https://dot.net/","published":"2024-08-13T12:59:15.683+00:00","requireLicenseAcceptance":false,"summary":"","tags":[""],"title":"","version":"9.0.0-preview.7.24405.7"},"packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/9.0.0-preview.7.24405.7/system.text.json.9.0.0-preview.7.24405.7.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json"}],"parent":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json","lower":"5.0.0-rc.2.20475.5","upper":"9.0.0-preview.7.24405.7","@context":{"@vocab":"http://schema.nuget.org/schema#","catalog":"http://schema.nuget.org/catalog#","xsd":"http://www.w3.org/2001/XMLSchema#","items":{"@id":"catalog:item","@container":"@set"},"commitTimeStamp":{"@id":"catalog:commitTimeStamp","@type":"xsd:dateTime"},"commitId":{"@id":"catalog:commitId"},"count":{"@id":"catalog:count"},"parent":{"@id":"catalog:parent","@type":"@id"},"tags":{"@id":"tag","@container":"@set"},"reasons":{"@cont