istration5-gz-semver2/system.text.encodings.web/index.json"}],"targetFramework":"Xamarin.WatchOS1.0"}],"deprecation":{"@id":"https://api.nuget.org/v3/catalog0/data/2026.04.09.20.51.46/system.text.json.4.7.2.json#deprecation","@type":"deprecation","message":"Versions targeting out-of-support .NET versions","reasons":["Legacy"]},"description":"Provides high-performance and low-allocating types that serialize objects to JavaScript Object Notation (JSON) text and deserialize JSON text to objects, with UTF-8 support built-in. Also provides types to read and write JSON text encoded as UTF-8, and to create an in-memory document object model (DOM), that is read-only, for random access of the JSON elements within a structured view of the data.\n\nCommonly Used Types:\nSystem.Text.Json.JsonSerializer\nSystem.Text.Json.JsonDocument\nSystem.Text.Json.JsonElement\nSystem.Text.Json.Utf8JsonWriter\nSystem.Text.Json.Utf8JsonReader\n \nWhen using NuGet 3.x this package requires at least version 3.4.","iconUrl":"https://api.nuget.org/v3-flatcontainer/system.text.json/4.7.2/icon","id":"System.Text.Json","language":"","licenseExpression":"MIT","licenseUrl":"https://www.nuget.org/packages/System.Text.Json/4.7.2/license","listed":true,"minClientVersion":"2.12","packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/4.7.2/system.text.json.4.7.2.nupkg","projectUrl":"https://github.com/dotnet/corefx","published":"2020-05-12T14:56:31.747+00:00","requireLicenseAcceptance":false,"summary":"","tags":[""],"title":"System.Text.Json","version":"4.7.2"},"packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/4.7.2/system.text.json.4.7.2.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/5.0.0-preview.1.20120.5.json","@type":"Package","commitId":"3e48c5db-f94f-4974-ae6d-0d56bf2962e1","commitTimeStamp":"2026-04-09T20:54:31.0680465+00:00","c