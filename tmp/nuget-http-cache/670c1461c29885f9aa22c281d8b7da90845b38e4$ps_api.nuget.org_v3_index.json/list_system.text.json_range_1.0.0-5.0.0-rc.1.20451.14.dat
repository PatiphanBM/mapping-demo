xt.Json.JsonSerializer\nSystem.Text.Json.JsonDocument\nSystem.Text.Json.JsonElement\nSystem.Text.Json.Utf8JsonWriter\nSystem.Text.Json.Utf8JsonReader\n \nWhen using NuGet 3.x this package requires at least version 3.4.","iconUrl":"https://api.nuget.org/v3-flatcontainer/system.text.json/4.6.0-preview9.19421.4/icon","id":"System.Text.Json","language":"","licenseExpression":"","licenseUrl":"https://github.com/dotnet/corefx/blob/master/LICENSE.TXT","listed":true,"minClientVersion":"2.12","packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/4.6.0-preview9.19421.4/system.text.json.4.6.0-preview9.19421.4.nupkg","projectUrl":"https://github.com/dotnet/corefx","published":"2019-09-04T15:56:56.307+00:00","requireLicenseAcceptance":false,"summary":"","tags":[""],"title":"System.Text.Json","version":"4.6.0-preview9.19421.4"},"packageContent":"https://api.nuget.org/v3-flatcontainer/system.text.json/4.6.0-preview9.19421.4/system.text.json.4.6.0-preview9.19421.4.nupkg","registration":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/index.json"},{"@id":"https://api.nuget.org/v3/registration5-gz-semver2/system.text.json/4.6.0-rc1.19456.4.json","@type":"Package","commitId":"3e48c5db-f94f-4974-ae6d-0d56bf2962e1","commitTimeStamp":"2026-04-09T20:54:31.0680465+00:00","catalogEntry":{"@id":"https://api.nuget.org/v3/catalog0/data/2026.04.09.20.51.46/system.text.json.4.6.0-rc1.19456.4.json","@type":"PackageDetails","authors":"Microsoft","dependencyGroups":[{"@id":"https://api.nuget.org/v3/catalog0/data/2026.04.09.20.51.46/system.text.json.4.6.0-rc1.19456.4.json#dependencygroup/monoandroid1.0","@type":"PackageDependencyGroup","dependencies":[{"@id":"https://api.nuget.org/v3/catalog0/data/2026.04.09.20.51.46/system.text.json.4.6.0-rc1.19456.4.json#dependencygroup/monoandroid1.0/microsoft.bcl.asyncinterfaces","@type":"PackageDependency","id":"Microsoft.Bcl.AsyncInterfaces","range":"[1.0.0-rc1.19456.4, )","registration":"https://api.nuget.org/v3/registra