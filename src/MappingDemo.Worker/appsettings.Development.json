{
  "ConnectionStrings": {
    "Mapping": "Host=localhost;Port=5432;Database=mapping;Username=mapping;Password=mapping"
  },
  "Paths": {
    "InputRoot": "D:\\Project\\mapping-demo\\input",
    "ArchiveRoot": "D:\\Project\\mapping-demo\\archive"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "FileImportConsumers": 1,
    "NormalizeConsumers": 1,
    "DeliveryConsumers": 1,
    "JsonExportConsumers": 1
  },
  "Import": {
    "DelaySeconds": 1,
    "StagingRoot": "../../data/staging"
  },
  "Features": {
    "UseDestinationModule": true
  },
  "ApiDelivery": {
    "PayloadEncryptionKeyReference": "delivery-payload-v1"
  },
  "JsonExport": {
    "PayloadEncryptionKeyReference": "json-export-payload-v1"
  },
  "FileDestinationProfiles": {
    "Profiles": [
      {
        "Id": "local-json-export",
        "Enabled": true,
        "OutputRoot": "D:\\Project\\mapping-demo\\output\\json",
        "EncryptionPolicy": "volume-encrypted",
        "QuotaBytes": 1073741824,
        "MinimumFreeBytes": 536870912,
        "UpdatedAt": "2026-10-21T00:00:00Z",
        "TimeoutSeconds": 10,
        "SupportedContracts": [
          { "Id": "proposal", "Version": "1", "Reference": "proposal/1" }
        ],
        "PayloadBindings": [
          { "TargetPath": "envelope.contractReference", "Source": "ContractReference" },
          { "TargetPath": "envelope.fileJobId", "Source": "FileJobId" },
          { "TargetPath": "envelope.sourceRowId", "Source": "SourceRowId" },
          { "TargetPath": "envelope.sourceRowNumber", "Source": "SourceRowNumber" },
          { "TargetPath": "envelope.configVersionReference", "Source": "ConfigVersionReference" },
          { "TargetPath": "envelope.outputKey", "Source": "OutputKey" }
        ]
      }
    ]
  },
  "Demo": {
    "ImportRowDelayMs": 100,
    "FailImportAtRow": null,
    "FailNormalizeRowNumbers": [],
    "NormalizeDelayMs": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
