{
  "ConnectionStrings": {
    "Mapping": "Host=localhost;Port=5432;Database=mapping;Username=mapping;Password=mapping"
  },
  "Features": {
    "ApiContractDestinationCreation": true
  },
  "ApiDelivery": {
    "AllowExplicitResend": true,
    "AllowOperationsControl": true
  },
  "ProfileAdministration": {
    "AllowLocalOperatorHeader": true
  },
  "ContractRegistry": {
    "SourceMode": "Postgres",
    "AllowLocalOperatorHeader": true,
    "PublishingEnabled": true
  },
  "TableAdministration": {
    "AllowLocalOperatorHeader": true,
    "MutationsEnabled": true
  },
  "FileDestinationProfiles": {
    "Profiles": [
      {
        "Id": "local-json-export",
        "Enabled": true,
        "OutputRoot": "D:\\Project\\mapping-demo\\output\\json",
        "EncryptionPolicy": "volume-encrypted",
        "QuotaBytes": 1073741824,
        "MinimumFreeBytes": 536870912,
        "UpdatedAt": "2026-10-21T00:00:00Z",
        "TimeoutSeconds": 10,
        "SupportedContracts": [
          { "Id": "proposal", "Version": "1", "Reference": "proposal/1" }
        ],
        "PayloadBindings": [
          { "TargetPath": "envelope.contractReference", "Source": "ContractReference" },
          { "TargetPath": "envelope.fileJobId", "Source": "FileJobId" },
          { "TargetPath": "envelope.sourceRowId", "Source": "SourceRowId" },
          { "TargetPath": "envelope.sourceRowNumber", "Source": "SourceRowNumber" },
          { "TargetPath": "envelope.configVersionReference", "Source": "ConfigVersionReference" },
          { "TargetPath": "envelope.outputKey", "Source": "OutputKey" }
        ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  }
}
