{
  "Paths": {
    "InputRoot": "D:\\Project\\mapping-demo\\input"
  },
  "Watcher": {
    "ConfigRefreshSeconds": 10,
    "ScanIntervalSeconds": 60
  },
  "Features": {
    "ApiContractDestinationCreation": false
  },
  "ApiDestinationProfileCatalog": {
    "SourceMode": "Postgres"
  },
  "ContractRegistry": {
    "SourceMode": "Postgres",
    "AllowLocalOperatorHeader": false,
    "PublishingEnabled": false
  },
  "TableAdministration": {
    "AllowLocalOperatorHeader": false,
    "MutationsEnabled": false
  },
  "FileDestinationProfiles": {
    "Profiles": []
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
